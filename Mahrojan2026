    <script>
        // ============================================
        // ระบบนับจำนวนผู้เข้าชมแบบเรียลไทม์
        // ใช้ localStorage จำลองการนับร่วมกันในเบราว์เซอร์เดียว
        // และใช้ BroadcastChannel + storage event เพื่อ sync ข้ามแท็บ
        // ============================================

        (function() {
            const COUNTER_KEY = 'mahrjan_viewer_count';
            const SESSION_KEY = 'mahrjan_session_id';
            const viewerEl = document.getElementById('viewerCount');

            // สร้าง session id เฉพาะสำหรับแท็บนี้
            function getSessionId() {
                let sid = sessionStorage.getItem(SESSION_KEY);
                if (!sid) {
                    sid = 'sid_' + Math.random().toString(36).substr(2, 9) + '_' + Date.now();
                    sessionStorage.setItem(SESSION_KEY, sid);
                }
                return sid;
            }

            // อ่านจำนวนปัจจุบัน
            function getCount() {
                const val = localStorage.getItem(COUNTER_KEY);
                return val ? parseInt(val, 10) : 0;
            }

            // บันทึกจำนวน
            function setCount(n) {
                const newVal = Math.max(0, n);
                localStorage.setItem(COUNTER_KEY, newVal);
                return newVal;
            }

            // อัปเดต UI
            function updateUI(count, animate = false) {
                if (!viewerEl) return;
                viewerEl.textContent = count;
                if (animate) {
                    viewerEl.classList.add('bump');
                    setTimeout(() => viewerEl.classList.remove('bump'), 300);
                }
            }

            // ลงทะเบียนผู้เข้าชมใหม่ (เพิ่ม 1)
            function registerViewer() {
                let count = getCount();
                count = setCount(count + 1);
                updateUI(count, true);
                return count;
            }

            // ลดจำนวนเมื่อออก
            function unregisterViewer() {
                let count = getCount();
                count = setCount(count - 1);
                updateUI(count, false);
                return count;
            }

            // เริ่มต้น
            const initialCount = registerViewer();

            // Sync ข้ามแท็บด้วย storage event
            window.addEventListener('storage', function(e) {
                if (e.key === COUNTER_KEY) {
                    const newCount = e.newValue ? parseInt(e.newValue, 10) : 0;
                    updateUI(newCount, true);
                }
            });

            // Sync ด้วย BroadcastChannel (ถ้ารองรับ)
            let bc = null;
            if (typeof BroadcastChannel !== 'undefined') {
                bc = new BroadcastChannel('mahrjan_counter');
                bc.onmessage = function(e) {
                    if (e.data && e.data.type === 'count_update') {
                        updateUI(e.data.count, true);
                    }
                };
            }

            // แจ้งเพื่อนแท็บเมื่อมีการเปลี่ยนแปลง
            function broadcastCount(count) {
                if (bc) {
                    bc.postMessage({ type: 'count_update', count: count });
                }
            }

            // override setCount เพื่อ broadcast
            const originalSetCount = setCount;
            setCount = function(n) {
                const val = originalSetCount(n);
                broadcastCount(val);
                return val;
            };

            // เมื่อผู้ใช้ปิด/ออกจากหน้า
            window.addEventListener('beforeunload', function() {
                unregisterViewer();
            });

            // กรณี tab ถูกซ่อน/แสดง (อาจนับเฉพาะเมื่อ visible)
            // แต่เพื่อความง่าย เรานับเฉพาะตอนโหลดและ beforeunload

            // อัปเดต UI ครั้งแรก
            updateUI(initialCount, false);

            // จำลองการเปลี่ยนแปลงแบบสุ่มเล็กน้อยเพื่อให้ดูเรียลไทม์ (optional)
            // เพื่อให้เห็นการขยับของตัวเลข
            setInterval(function() {
                // สุ่ม 30% ที่จะมีการเปลี่ยนแปลงเล็กน้อย
                if (Math.random() < 0.3) {
                    // สุ่ม +1 หรือ -1 แต่ไม่ให้ต่ำกว่า 1
                    const current = getCount();
                    if (current > 1 && Math.random() < 0.5) {
                        // ลดลง (จำลองคนออก)
                        const newCount = setCount(current - 1);
                        updateUI(newCount, true);
                    } else {
                        // เพิ่มขึ้น (จำลองคนเข้า)
                        const newCount = setCount(current + 1);
                        updateUI(newCount, true);
                    }
                }
            }, 4000);

            // เก็บฟังก์ชันไว้ใช้ในปุ่ม
            window.__refreshViewer = function() {
                const c = getCount();
                updateUI(c, true);
            };

        })();

        // ============================================
        // ปุ่มต่างๆ
        // ============================================

        function refreshPage(e) {
            e.preventDefault();
            // จำลองการรีเฟรช
            const btn = e.currentTarget;
            const originalHTML = btn.innerHTML;
            btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> กำลังโหลด...';
            btn.style.opacity = '0.7';
            btn.style.pointerEvents = 'none';

            setTimeout(() => {
                btn.innerHTML = originalHTML;
                btn.style.opacity = '1';
                btn.style.pointerEvents = 'auto';
                // อัปเดตตัวนับ
                if (window.__refreshViewer) window.__refreshViewer();
                // แสดงข้อความ
                alert('ขออภัย ระบบยังอยู่ระหว่างการแก้ไข\nกรุณาลองใหม่อีกครั้งในภายหลัง');
            }, 1200);
        }

        function notifyMe(e) {
            e.preventDefault();
            alert('✅ ระบบจะแจ้งเตือนคุณเมื่อการแข่งขันเปิดรับสมัครอย่างเป็นทางการ\n\nجزاكم الله خيرا');
        }

        // แจ้งเตือนเมื่อคลิกที่กล่องขออภัย
        document.querySelector('.apology-box')?.addEventListener('click', function() {
