<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ขออภัย • กิจกรรมการแข่งขันวานเฟ้นหาดาเด่น ครั้งที่ 8 ปี 2026</title>
    <link href="https://fonts.googleapis.com/css2?family=Kanit:wght@300;400;600;700&family=Amiri:wght@400;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Kanit', sans-serif;
            background: linear-gradient(145deg, #0b1a2e 0%, #1a3a4a 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
            position: relative;
            overflow-x: hidden;
        }

        body::before {
            content: "";
            position: absolute;
            top: 0; left: 0; right: 0; bottom: 0;
            background-image: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100" opacity="0.05"><path d="M50 0 L100 50 L50 100 L0 50 Z" fill="none" stroke="%23d4af37" stroke-width="1"/><circle cx="50" cy="50" r="20" fill="none" stroke="%23d4af37" stroke-width="0.8"/><path d="M50 20 L60 40 L80 50 L60 60 L50 80 L40 60 L20 50 L40 40 Z" fill="%23d4af37" opacity="0.3"/></svg>');
            background-size: 120px 120px;
            pointer-events: none;
            z-index: 0;
        }

        .container {
            max-width: 1000px;
            width: 100%;
            position: relative;
            z-index: 2;
            background: rgba(10, 25, 40, 0.75);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border-radius: 48px;
            padding: 40px 35px;
            box-shadow: 0 30px 60px rgba(0, 0, 0, 0.6), 0 0 0 1px rgba(212, 175, 55, 0.2);
            border: 1px solid rgba(212, 175, 55, 0.3);
        }

        .header {
            text-align: center;
            margin-bottom: 30px;
            border-bottom: 2px dashed rgba(212, 175, 55, 0.5);
            padding-bottom: 25px;
        }

        .bismillah {
            font-family: 'Amiri', serif;
            font-size: 2rem;
            color: #d4af37;
            margin-bottom: 10px;
            letter-spacing: 1px;
            text-shadow: 0 0 15px rgba(212, 175, 55, 0.5);
        }

        .title-main {
            font-size: 2.4rem;
            font-weight: 700;
            color: #ffffff;
            line-height: 1.4;
            margin: 10px 0;
            text-shadow: 0 4px 20px rgba(0, 0, 0, 0.8);
        }

        .title-main .highlight {
            color: #d4af37;
            background: linear-gradient(135deg, #d4af37, #f9e076);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            font-size: 2.8rem;
        }

        .sub-arabic {
            font-family: 'Amiri', serif;
            font-size: 1.8rem;
            color: #d4af37;
            margin: 10px 0;
            font-weight: 700;
            direction: rtl;
        }

        .salam {
            font-size: 1.5rem;
            color: #e0e0e0;
            margin: 15px 0;
            font-weight: 300;
        }

        .salam i {
            color: #d4af37;
            margin: 0 8px;
        }

        .apology-box {
            background: rgba(220, 53, 69, 0.15);
            border: 2px solid #dc3545;
            border-radius: 24px;
            padding: 25px 20px;
            margin: 30px 0;
            text-align: center;
            box-shadow: 0 0 30px rgba(220, 53, 69, 0.3);
            animation: pulseBorder 2s infinite;
        }

        @keyframes pulseBorder {
            0% { border-color: #dc3545; box-shadow: 0 0 20px rgba(220, 53, 69, 0.3); }
            50% { border-color: #ff6b6b; box-shadow: 0 0 45px rgba(220, 53, 69, 0.6); }
            100% { border-color: #dc3545; box-shadow: 0 0 20px rgba(220, 53, 69, 0.3); }
        }

        .apology-box i {
            font-size: 3rem;
            color: #ff6b6b;
            margin-bottom: 10px;
        }

        .apology-box h2 {
            font-size: 2rem;
            color: #ffb3b3;
            margin-bottom: 10px;
            font-weight: 600;
        }

        .apology-box p {
            font-size: 1.3rem;
            color: #f0f0f0;
            line-height: 1.7;
            margin-bottom: 8px;
        }

        .apology-box .urgent {
            color: #ffd966;
            font-weight: 600;
            font-size: 1.4rem;
            margin-top: 10px;
            display: block;
        }

        /* ============ ส่วนนับจำนวนครั้งที่เข้าชม ============ */
        .counter-section {
            background: linear-gradient(135deg, rgba(212, 175, 55, 0.15), rgba(212, 175, 55, 0.05));
            border-radius: 30px;
            padding: 30px 25px;
            margin: 30px 0 20px;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 12px;
            border: 1px solid rgba(212, 175, 55, 0.4);
            box-shadow: inset 0 0 25px rgba(212, 175, 55, 0.1), 0 10px 40px rgba(0, 0, 0, 0.3);
            position: relative;
            overflow: hidden;
        }

        .counter-section::before {
            content: "";
            position: absolute;
            top: -50%;
            left: -50%;
            width: 200%;
            height: 200%;
            background: radial-gradient(circle, rgba(212, 175, 55, 0.08) 0%, transparent 70%);
            animation: rotateGlow 20s linear infinite;
            pointer-events: none;
        }

        @keyframes rotateGlow {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }

        .counter-label {
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: 1.15rem;
            color: #d4af37;
            font-weight: 400;
            letter-spacing: 0.5px;
            z-index: 1;
        }

        .counter-label i {
            font-size: 1.4rem;
            animation: pulseIcon 2s infinite;
        }

        @keyframes pulseIcon {
            0%, 100% { transform: scale(1); opacity: 1; }
            50% { transform: scale(1.15); opacity: 0.8; }
        }

        .counter-number {
            font-size: 4.5rem;
            font-weight: 700;
            background: linear-gradient(135deg, #f9e076, #d4af37, #b8962e);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            letter-spacing: 3px;
            line-height: 1;
            text-shadow: 0 0 40px rgba(212, 175, 55, 0.5);
            transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
            z-index: 1;
            font-variant-numeric: tabular-nums;
        }

        .counter-number.bump {
            transform: scale(1.15);
        }

        .counter-sub {
            font-size: 1rem;
            color: #aaa;
            letter-spacing: 1px;
            z-index: 1;
        }

        .counter-sub .today {
            color: #d4af37;
            font-weight: 600;
        }

        .live-badge {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            background: #dc3545;
            color: white;
            font-size: 0.75rem;
            font-weight: 600;
            padding: 5px 14px;
            border-radius: 50px;
            letter-spacing: 1px;
            animation: livePulse 1.5s infinite;
            z-index: 1;
            margin-top: 5px;
        }

        .live-badge::before {
            content: "";
            width: 8px;
            height: 8px;
            background: white;
            border-radius: 50%;
            animation: livePulse 1.5s infinite;
        }

        @keyframes livePulse {
            0% { opacity: 1; }
            50% { opacity: 0.4; }
            100% { opacity: 1; }
        }

        /* ============ รายการแข่งขัน ============ */
        .competition-title {
            font-size: 1.8rem;
            color: #d4af37;
            text-align: center;
            margin: 35px 0 20px;
            font-weight: 600;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 12px;
        }

        .competition-title i {
            font-size: 2rem;
        }

        .list-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 12px;
            margin-bottom: 30px;
        }

        .list-item {
            background: rgba(255, 255, 255, 0.06);
            border-radius: 16px;
            padding: 14px 18px;
            display: flex;
            align-items: center;
            gap: 12px;
            color: #f0f0f0;
            font-size: 1.05rem;
            border-left: 4px solid #d4af37;
            transition: all 0.3s ease;
            backdrop-filter: blur(4px);
            border: 1px solid rgba(212, 175, 55, 0.15);
        }

        .list-item:hover {
            background: rgba(212, 175, 55, 0.15);
            transform: translateX(6px);
            border-left-color: #f9e076;
            box-shadow: 0 8px 20px rgba(0, 0, 0, 0.3);
        }

        .list-item .num {
            background: #d4af37;
            color: #0b1a2e;
            font-weight: 700;
            width: 32px;
            height: 32px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
            font-size: 0.95rem;
            flex-shrink: 0;
        }

        .list-item .name {
            font-weight: 400;
            line-height: 1.4;
        }

        .note-box {
            background: rgba(212, 175, 55, 0.08);
            border-radius: 20px;
            padding: 22px 25px;
            margin: 25px 0 15px;
            border: 1px solid rgba(212, 175, 55, 0.25);
            text-align: center;
        }

        .note-box p {
            color: #e0e0e0;
            font-size: 1.15rem;
            line-height: 1.9;
        }

        .note-box .dua {
            font-family: 'Amiri', serif;
            font-size: 1.6rem;
            color: #d4af37;
            margin-top: 15px;
            direction: rtl;
            font-weight: 700;
        }

        .note-box .dua-trans {
            font-size: 1rem;
            color: #aaa;
            margin-top: 5px;
        }

        .btn-group {
            display: flex;
            gap: 15px;
            justify-content: center;
            flex-wrap: wrap;
            margin-top: 25px;
        }

        .btn {
            padding: 14px 35px;
            border-radius: 50px;
            font-family: 'Kanit', sans-serif;
            font-size: 1.1rem;
            font-weight: 600;
            border: none;
            cursor: pointer;
            transition: all 0.3s ease;
            display: inline-flex;
            align-items: center;
            gap: 10px;
            text-decoration: none;
        }

        .btn-primary {
            background: linear-gradient(135deg, #d4af37, #b8962e);
            color: #0b1a2e;
            box-shadow: 0 10px 30px rgba(212, 175, 55, 0.3);
        }

        .btn-primary:hover {
            transform: translateY(-3px);
            box-shadow: 0 15px 40px rgba(212, 175, 55, 0.5);
            background: linear-gradient(135deg, #f9e076, #d4af37);
        }

        .btn-outline {
            background: transparent;
            color: #d4af37;
            border: 2px solid #d4af37;
        }

        .btn-outline:hover {
            background: rgba(212, 175, 55, 0.15);
            transform: translateY(-3px);
        }

        .footer-note {
            text-align: center;
            margin-top: 30px;
            color: #888;
            font-size: 0.95rem;
            border-top: 1px solid rgba(255, 255, 255, 0.08);
            padding-top: 20px;
        }

        .footer-note i {
            color: #d4af37;
            margin: 0 4px;
        }

        /* Responsive */
        @media (max-width: 768px) {
            .container { padding: 25px 18px; border-radius: 32px; }
            .title-main { font-size: 1.6rem; }
            .title-main .highlight { font-size: 2rem; }
            .bismillah { font-size: 1.5rem; }
            .sub-arabic { font-size: 1.4rem; }
            .salam { font-size: 1.15rem; }
            .apology-box h2 { font-size: 1.5rem; }
            .apology-box p { font-size: 1.1rem; }
            .counter-number { font-size: 3.2rem; }
            .counter-label { font-size: 1rem; }
            .list-grid { grid-template-columns: 1fr; }
            .competition-title { font-size: 1.4rem; }
            .list-item { font-size: 0.95rem; padding: 12px 14px; }
            .note-box p { font-size: 1rem; }
            .btn { padding: 12px 25px; font-size: 1rem; width: 100%; justify-content: center; }
            .btn-group { flex-direction: column; }
        }

        @media (max-width: 400px) {
            .title-main { font-size: 1.3rem; }
            .title-main .highlight { font-size: 1.6rem; }
            .counter-number { font-size: 2.6rem; }
        }
    </style>
</head>
<body>

    <div class="container" id="mainContainer">

        <!-- ส่วนหัว -->
        <div class="header">
            <div class="bismillah">بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ</div>
            <div class="sub-arabic">المهرجان</div>
            <h1 class="title-main">
                กิจกรรมการแข่งขันวานเฟ้นหา<br>
                <span class="highlight">ดาเด่น ครั้งที่ 8</span><br>
                ปี 2026
            </h1>
            <div class="salam">
                <i class="fas fa-hand-peace"></i>
