        <!-- ปุ่ม -->
        <div class="btn-group">
            <a href="#" class="btn btn-primary" onclick="refreshPage(event)">
                <i class="fas fa-sync-alt"></i> ลองใหม่อีกครั้ง
            </a>
            <a href="#" class="btn btn-outline" onclick="notifyMe(event)">
                <i class="fas fa-bell"></i> แจ้งเตือนฉัน
            </a>
        </div>

        <div class="footer-note">
