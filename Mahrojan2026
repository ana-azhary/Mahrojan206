        </div>

        <!-- ============ ตัวนับจำนวนครั้งที่เข้าชม (สะสม) ============ -->
        <div class="counter-section">
            <div class="counter-label">
                <i class="fas fa-chart-line"></i>
                จำนวนผู้เข้าชมสะสมทั้งหมด
            </div>
            <div class="counter-number" id="viewerCount">0</div>
