            ขออภัยในความไม่สะดวก • ทีมงานالمهرجان
            <i class="fas fa-mosque"></i>
        </div>
    </div>

    <script>
        // ============================================
        // ระบบนับจำนวนครั้งที่เข้าชมสะสม (Total Views)
        // บันทึกถาวรใน localStorage
        // - นับเพิ่มทุกครั้งที่โหลดหน้าเว็บ
        // - ป้องกันการนับซ้ำในแท็บเดียวกัน (นับ 1 ครั้งต่อแท็บ)
        // - sync ข้ามแท็บแบบเรียลไทม์
        // ============================================

        (function() {
            const TOTAL_KEY = 'mahrjan_total_views';      // ยอดรวมทั้งหมด
            const TODAY_KEY = 'mahrjan_today_views';      // ยอดวันนี้
            const TODAY_DATE_KEY = 'mahrjan_today_date';  // วันที่บันทึกล่าสุด
            const TAB_FLAG = 'mahrjan_counted_tab';       // flag กันนับซ้ำในแท็บเดิม

            const viewerEl = document.getElementById('viewerCount');
            const todayEl = document.getElementById('todayCount');

            // --- วันที่ปัจจุบัน (YYYY-MM-DD) ---
            function getTodayStr() {
                const d = new Date();
                const y = d.getFullYear();
                const m = String(d.getMonth() + 1).padStart(2, '0');
                const day = String(d.getDate()).padStart(2, '0');
                return `${y}-${m}-${day}`;
            }

            // --- อ่านค่าตัวเลขจาก localStorage ---
            function readNum(key) {
                const v = localStorage.getItem(key);
                return v ? parseInt(v, 10) : 0;
            }

            // --- เขียนค่าตัวเลข ---
            function writeNum(key, n) {
                localStorage.setItem(key, Math.max(0, n));
            }

            // --- อัปเดต UI ---
            function updateUI(total, today, animate) {
                if (viewerEl) {
                    viewerEl.textContent = total.toLocaleString('en-US');
                    if (animate) {
                        viewerEl.classList.add('bump');
                        setTimeout(() => viewerEl.classList.remove('bump'), 350);
                    }
                }
                if (todayEl) {
                    todayEl.textContent = today.toLocaleString('en-US');
                }
            }

            // --- เริ่มต้น: เพิ่มยอดเข้าชม ---
            function registerVisit() {
                const todayStr = getTodayStr();
                const lastDate = localStorage.getItem(TODAY_DATE_KEY);

                // ถ้าเป็นวันใหม่ → reset ยอดวันนี้
                if (lastDate !== todayStr) {
                    localStorage.setItem(TODAY_DATE_KEY, todayStr);
                    writeNum(TODAY_KEY, 0);
                }

                // เพิ่มยอดรวม
                let total = readNum(TOTAL_KEY);
                total += 1;
                writeNum(TOTAL_KEY, total);

                // เพิ่มยอดวันนี้
                let today = readNum(TODAY_KEY);
                today += 1;
                writeNum(TODAY_KEY, today);

                return { total, today };
            }

            // --- Sync ข้ามแท็บ ---
            function refreshFromStorage(animate) {
                const total = readNum(TOTAL_KEY);
                const today = readNum(TODAY_KEY);
                updateUI(total, today, animate);
            }

            // --- เริ่มต้นทำงาน ---
            const isCountedThisTab = sessionStorage.getItem(TAB_FLAG);

            if (!isCountedThisTab) {
                // แท็บนี้ยังไม่เคยนับ → นับครั้งแรก
                sessionStorage.setItem(TAB_FLAG, '1');
                const { total, today } = registerVisit();
                updateUI(total, today, true);

                // แจ้งเพื่อนแท็บอื่นให้อัปเดต
                if (typeof BroadcastChannel !== 'undefined') {
                    const bc = new BroadcastChannel('mahrjan_views');
                    bc.postMessage({ total, today });
                    bc.close();
                }
            } else {
                // แท็บนี้เคยนับแล้ว (เช่น refresh) → แค่แสดงค่าล่าสุด
                refreshFromStorage(false);
            }

            // --- รับการอัปเดตจากแท็บอื่น ---
            window.addEventListener('storage', function(e) {
                if (e.key === TOTAL_KEY || e.key === TODAY_KEY) {
                    refreshFromStorage(true);
                }
            });

            if (typeof BroadcastChannel !== 'undefined') {
                const bc = new BroadcastChannel('mahrjan_views');
                bc.onmessage = function(e) {
                    if (e.data && typeof e.data.total === 'number') {
                        updateUI(e.data.total, e.data.today, true);
                    }
                };
            }

            // --- ตรวจสอบการเปลี่ยนวัน (ถ้าเปิดหน้าเว็บข้ามวัน) ---
            setInterval(function() {
                const todayStr = getTodayStr();
                const lastDate = localStorage.getItem(TODAY_DATE_KEY);
                if (lastDate !== todayStr) {
                    localStorage.setItem(TODAY_DATE_KEY, todayStr);
                    writeNum(TODAY_KEY, 0);
                    refreshFromStorage(true);
                }
            }, 60000); // ตรวจทุก 1 นาที
        })();

        // ============================================
        // ปุ่มต่างๆ
        // ============================================

        function refreshPage(e) {
            e.preventDefault();
            const btn = e.currentTarget;
            const originalHTML = btn.innerHTML;
            btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> กำลังโหลด...';
            btn.style.opacity = '0.7';
            btn.style.pointerEvents = 'none';

            setTimeout(() => {
                btn.innerHTML = originalHTML;
                btn.style.opacity = '1';
                btn.style.pointerEvents = 'auto';
                alert('ขออภัย ระบบยังอยู่ระหว่างการแก้ไข\nกรุณาลองใหม่อีกครั้งในภายหลัง');
            }, 1200);
        }

        function notifyMe(e) {
            e.preventDefault();
            alert('✅ ระบบจะแจ้งเตือนคุณเมื่อการแข่งขันเปิดรับสมัครอย่างเป็นทางการ\n\nجزاكم الله خيرا');
        }

        console.log('เว็บไซต์พร้อมใช้งาน • กิจกรรมการแข่งขันวานเฟ้นหาดาเด่น ครั้งที่ 8 ปี 2026');
    </script>
